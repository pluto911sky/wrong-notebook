/* iOS 规范 44×26px 胶囊开关（带阻尼弹簧动画与按压延展态） */
.ls-track {
  position: relative;
  width: 44px;
  height: 26px;
  padding: 2px;
  box-sizing: border-box;
  border-radius: 999px;
  background: rgba(148, 163, 184, 0.34);
  border: 1px solid rgba(255, 255, 255, 0.55);
  box-shadow: inset 0 1px 3px rgba(15, 23, 42, 0.12);
  transition: background-color 240ms cubic-bezier(0.22, 1, 0.36, 1),
              border-color 240ms ease,
              box-shadow 240ms ease;
  flex-shrink: 0;
}

.ls-track.ls-checked {
  background: linear-gradient(135deg, #2563EB 0%, #4F46E5 100%);
  border-color: rgba(255, 255, 255, 0.32);
  box-shadow: 0 3px 10px -2px rgba(37, 99, 235, 0.42),
              inset 0 1px 0 rgba(255, 255, 255, 0.25);
}

.ls-thumb {
  width: 20px;
  height: 20px;
  border-radius: 999px;
  background: #FFFFFF;
  box-shadow: 0 2px 6px rgba(15, 23, 42, 0.22),
              0 1px 1px rgba(15, 23, 42, 0.08);
  transform: translateX(0);
  transition: transform 300ms cubic-bezier(0.34, 1.45, 0.64, 1),
              width 180ms cubic-bezier(0.22, 1, 0.36, 1);
}

.ls-track.ls-checked .ls-thumb {
  transform: translateX(18px);
}

/* 按压态：滑块沿横向微幅延展（iOS 触控阻尼感） */
.ls-track.ls-pressing .ls-thumb {
  width: 24px;
}

.ls-track.ls-checked.ls-pressing .ls-thumb {
  transform: translateX(14px);
}

.ls-track.ls-disabled {
  opacity: 0.48;
}

/* 减少透明与模糊模式：纯色高对比轨道 */
.ls-track.ls-reduce {
  background: #CBD5E1;
  border-color: #CBD5E1;
  box-shadow: none;
}

.ls-track.ls-reduce.ls-checked {
  background: #2563EB;
  border-color: #2563EB;
  box-shadow: none;
}
