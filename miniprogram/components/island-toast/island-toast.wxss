/* 灵动岛（Dynamic Island）风格悬浮深色胶囊 Toast */
.island-toast-host {
  position: fixed;
  top: 18rpx;
  left: 50%;
  z-index: 999;
  max-width: calc(100vw - 64rpx);
  pointer-events: none;
  opacity: 0;
  transform: translate3d(-50%, -22rpx, 0) scale(0.86);
  transition: opacity 220ms cubic-bezier(0.22, 1, 0.36, 1),
              transform 320ms cubic-bezier(0.34, 1.38, 0.64, 1);
}

.island-toast-host.is-visible {
  opacity: 1;
  transform: translate3d(-50%, 0, 0) scale(1);
}

.island-pill {
  display: inline-flex;
  align-items: center;
  gap: 14rpx;
  padding: 16rpx 28rpx 16rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(15, 23, 42, 0.84);
  backdrop-filter: blur(22px) saturate(180%);
  -webkit-backdrop-filter: blur(22px) saturate(180%);
  border: 1rpx solid rgba(255, 255, 255, 0.16);
  box-shadow: 0 18rpx 42rpx -8rpx rgba(15, 23, 42, 0.42),
              inset 0 1rpx 0 rgba(255, 255, 255, 0.18);
}

.island-pill.is-reduce {
  background: #0F172A;
  backdrop-filter: none;
  -webkit-backdrop-filter: none;
  border-color: rgba(255, 255, 255, 0.12);
  box-shadow: 0 10rpx 24rpx rgba(15, 23, 42, 0.24);
}

.island-badge {
  width: 38rpx;
  height: 38rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: rgba(56, 189, 248, 0.2);
  color: #38BDF8;
}

.type-success .island-badge {
  background: rgba(34, 197, 94, 0.22);
  color: #4ADE80;
}

.type-error .island-badge {
  background: rgba(244, 63, 94, 0.24);
  color: #FB7185;
}

.type-warn .island-badge {
  background: rgba(245, 158, 11, 0.24);
  color: #FBBF24;
}

.island-glyph {
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1;
}

.island-text {
  font-size: 25rpx;
  font-weight: 600;
  color: #F8FAFC;
  line-height: 1.35;
  letter-spacing: 0.2rpx;
}
