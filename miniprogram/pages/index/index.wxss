.index-shell {
  min-height: 100vh;
  background: #F3F6FB;
  display: flex;
  flex-direction: column;
  padding-bottom: 0;
}

.index-shell.has-recent {
  padding-bottom: calc(154rpx + env(safe-area-inset-bottom));
}

/* 未登录顶部品牌胶囊栏 */
.guest-header-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.brand-pill {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 10rpx 20rpx 10rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.76);
  backdrop-filter: blur(18px) saturate(170%);
  -webkit-backdrop-filter: blur(18px) saturate(170%);
  border: 1rpx solid rgba(255, 255, 255, 0.92);
  box-shadow: 0 8rpx 22rpx -6rpx rgba(15, 23, 42, 0.08),
              inset 0 1rpx 0 rgba(255, 255, 255, 0.95);
}

.brand-pill-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 18rpx;
  flex-shrink: 0;
}

.brand-pill-text {
  display: flex;
  flex-direction: column;
  line-height: 1.2;
}

.brand-pill-name {
  font-size: 29rpx;
  font-weight: 800;
  color: #0F172A;
}

.index-onboarding {
  background: #F7F8FB;
}

.onboarding-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-evenly;
  gap: 32rpx;
}

.onboarding-intro {
  padding: 18rpx 8rpx 0;
}

.onboarding-title {
  font-size: 46rpx;
  font-weight: 800;
  color: #17243A;
  line-height: 1.25;
}

.onboarding-sub {
  margin-top: 16rpx;
  font-size: 29rpx;
  color: #4E5D72;
  line-height: 1.5;
}

.onboarding-pets {
  background: #FFFFFF;
  border: 1rpx solid #DBE3EF;
  border-radius: 24rpx;
}

.onboarding-pets {
  padding: 24rpx 16rpx;
}

.pet-roster-row {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 8rpx;
}

.pet-roster-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.roster-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  background: #F7F3EB;
}

.roster-name {
  font-size: 23rpx;
  font-weight: 600;
  color: #374860;
  white-space: nowrap;
}

.onboarding-actions {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 16rpx;
}

button.onboarding-primary {
  margin: 0;
  border-radius: 20rpx;
  font-size: 33rpx;
  font-weight: 700;
  line-height: 88rpx;
}

button.onboarding-primary {
  background: #184687;
  color: #FFFFFF;
}

button.onboarding-privacy {
  align-self: center;
  background: transparent;
  color: #4E5D72;
  font-size: 26rpx;
}

/* ==================== 场景 B：已登录主工作台 ==================== */
.header-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.header-left {
  flex: 1;
  min-width: 0;
}

.greeting-title {
  font-size: 41rpx;
  font-weight: 800;
  color: #0F172A;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.quota-pill {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 10rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  border: 1rpx solid rgba(255, 255, 255, 0.88);
  box-shadow: 0 6rpx 16rpx -4rpx rgba(15, 23, 42, 0.06),
              inset 0 1rpx 0 rgba(255, 255, 255, 0.9);
  font-size: 26rpx;
  font-weight: 600;
  color: #334155;
}

.quota-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #10B981;
  flex-shrink: 0;
}

.quota-dot-warn {
  background: #F59E0B;
}

button.profile-button {
  flex-shrink: 0;
  margin: 4rpx 0 0;
  padding: 0 22rpx;
  height: 62rpx;
  line-height: 62rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(191, 219, 254, 0.88);
  background: #EAF1FC;
  box-shadow: 0 8rpx 20rpx -6rpx rgba(37, 99, 235, 0.18),
              inset 0 1rpx 0 rgba(255, 255, 255, 0.88);
  color: #1D4ED8;
  font-size: 26rpx;
  font-weight: 700;
  white-space: nowrap;
}

.home-first-screen {
  min-height: 100vh;
  margin-top: -24rpx;
  padding-top: 24rpx;
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
}

.home-dashboard {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.review-hero-card {
  padding: 26rpx 30rpx;
  margin-bottom: 0;
  background: #FFFFFF;
  border-color: #DCE4F0;
}

.review-heading {
  font-size: 37rpx;
  font-weight: 800;
  color: #17243A;
}

.review-status {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 12rpx;
  color: #475569;
  font-size: 25rpx;
}

button.progress-retry {
  margin: 0;
  color: #184687;
  background: #EDF2FA;
}

.hero-stats-row {
  display: flex;
  margin-top: 20rpx;
}

.hero-stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 5rpx;
}

.hero-stat + .hero-stat {
  border-left: 1rpx solid #DFE6F0;
}

.stat-num {
  color: #17243A;
  font-size: 46rpx;
  font-weight: 800;
  line-height: 1.18;
  font-variant-numeric: tabular-nums;
}

.stat-todo { color: #9A4B08; }
.stat-done { color: #087552; }

.stat-label {
  color: #334155;
  font-size: 28rpx;
  font-weight: 600;
}

.capture-section {
  flex: 1;
  min-height: 302rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

button.capture-entry {
  width: 248rpx;
  height: 248rpx;
  margin: 24rpx auto;
  border-radius: 50%;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 47rpx;
  font-weight: 800;
  line-height: 1.25;
  color: #FFFFFF;
  background: #184687;
  box-shadow: 0 14rpx 26rpx rgba(24, 70, 135, 0.24);
}

/* 伴学宠物精灵快捷胶囊 */
.pet-banner-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
  border-radius: 26rpx;
  border: 1rpx solid #DCE4F0;
  background: #FFFFFF;
  padding: 20rpx 22rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 6rpx 20rpx -6rpx rgba(234, 88, 12, 0.14);
  transition: transform 0.12s ease;
}

.pet-banner-card:active {
  transform: scale(0.99);
}

.pet-mini-avatar {
  width: 82rpx;
  height: 82rpx;
  border-radius: 22rpx;
  border: 2rpx solid #FFFFFF;
  background: #FFF9F2;
  flex-shrink: 0;
}

.pet-banner-mid {
  flex: 1;
  min-width: 0;
}

.pet-banner-top {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 8rpx;
}

.pet-banner-name {
  font-size: 33rpx;
  font-weight: 800;
  color: #0F172A;
  flex-shrink: 0;
}

.pet-banner-lv {
  font-size: 25rpx;
  font-weight: 600;
  color: #40516A;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.pet-mini-track {
  height: 10rpx;
  background: #E4EBF4;
  border-radius: 999rpx;
  overflow: hidden;
}

.pet-mini-fill {
  height: 100%;
  border-radius: 999rpx;
}

.pet-banner-sub {
  margin-top: 8rpx;
  font-size: 25rpx;
  color: #43536B;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.pet-banner-cta {
  flex-shrink: 0;
  font-size: 26rpx;
  font-weight: 700;
  color: #334155;
  background: #EAF1FC;
  padding: 10rpx 14rpx;
  border-radius: 999rpx;
}

/* 最近收录列表 */
.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.section-heading {
  font-size: 35rpx;
  font-weight: 800;
  color: #0F172A;
}

button.section-all-link {
  margin: 0;
  background: transparent;
  font-size: 26rpx;
  font-weight: 700;
  color: #2563EB;
  padding: 8rpx 12rpx;
}

.priority-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.priority-item {
  background: rgba(255, 255, 255, 0.94);
  border-radius: 24rpx;
  padding: 24rpx 26rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.95);
  border-left: 8rpx solid #F59E0B;
  box-shadow: 0 6rpx 18rpx -4rpx rgba(15, 23, 42, 0.05);
  transition: transform 0.12s ease, background 0.12s ease;
}

.priority-item:active {
  transform: scale(0.99);
  background: #F8FAFC;
}

.item-mastered {
  border-left-color: #10B981;
}

.item-todo {
  border-left-color: #F59E0B;
}

.priority-meta {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 12rpx;
}

.status-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.dot-todo {
  background: #F59E0B;
}

.dot-done {
  background: #10B981;
}

.priority-subject {
  font-size: 27rpx;
  font-weight: 700;
  color: #0F172A;
}

.priority-img-tag {
  font-size: 25rpx;
  color: #43536B;
  background: #F1F5F9;
  padding: 3rpx 10rpx;
  border-radius: 8rpx;
}

.priority-right {
  margin-left: auto;
  padding: 4rpx 14rpx;
  border-radius: 10rpx;
  font-size: 25rpx;
  font-weight: 700;
  white-space: nowrap;
}

.status-wait {
  background: #eef2f7;
  color: #495b73;
}

.status-ai {
  background: #ECFDF5;
  color: #087552;
}

.priority-brief {
  font-size: 33rpx;
  color: #273449;
  line-height: 1.6;
}

/* ==================== Layer 3 悬浮胶囊底栏 Dock（已登录工作台） ==================== */
.floating-nav-dock {
  position: fixed;
  left: 28rpx;
  right: 28rpx;
  bottom: calc(20rpx + env(safe-area-inset-bottom));
  z-index: 90;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 8rpx;
  padding: 10rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  border: 1rpx solid #DCE4F0;
  box-shadow: 0 12rpx 28rpx rgba(15, 23, 42, 0.1);
}

.nav-dock-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  padding: 10rpx 8rpx;
  border-radius: 999rpx;
  transition: transform 160ms cubic-bezier(0.22, 1, 0.36, 1), background-color 180ms ease;
}

.nav-dock-item:active {
  transform: scale(0.95);
}

.nav-dock-cta {
  background: #184687;
}

.nav-dock-icon {
  font-size: 30rpx;
  line-height: 1.1;
}

.nav-dock-label {
  font-size: 27rpx;
  font-weight: 700;
  color: #273449;
  line-height: 1.25;
}

.nav-dock-cta .nav-dock-label {
  color: #FFFFFF;
}
