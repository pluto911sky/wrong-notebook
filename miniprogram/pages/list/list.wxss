.list-shell {
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

/* 吸顶筛选舱（Layer 3 流体毛玻璃吸顶导航） */
.sticky-filter-panel {
  position: sticky;
  top: 0;
  z-index: 40;
  margin: -24rpx -28rpx 16rpx;
  padding: 20rpx 28rpx 18rpx;
  background: rgba(243, 246, 253, 0.74);
  backdrop-filter: blur(24px) saturate(180%);
  -webkit-backdrop-filter: blur(24px) saturate(180%);
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.85);
  box-shadow: 0 10rpx 28rpx -12rpx rgba(15, 23, 42, 0.08);
}

.search-bar {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.82);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  border-radius: 24rpx;
  padding: 0 12rpx 0 24rpx;
  height: 82rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.92);
  box-shadow: 0 6rpx 18rpx -6rpx rgba(15, 23, 42, 0.06),
              inset 0 1rpx 0 rgba(255, 255, 255, 0.95);
}

.search-icon {
  font-size: 30rpx;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #0F172A;
}

.clear-btn {
  padding: 10rpx 16rpx;
  color: #94A3B8;
  font-size: 26rpx;
}

.search-action {
  padding: 12rpx 24rpx;
  border-radius: 16rpx;
  background: #EFF6FF;
  color: #2563EB;
  font-size: 26rpx;
  font-weight: 700;
}

.filter-controls-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 16rpx;
}

.subject-filter-pill {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 14rpx 22rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.8);
  border: 1rpx solid rgba(255, 255, 255, 0.92);
  box-shadow: 0 4rpx 12rpx -4rpx rgba(15, 23, 42, 0.06);
  font-size: 27rpx;
  font-weight: 700;
  color: #0F172A;
}

.subject-filter-count {
  color: #64748B;
  font-weight: 600;
  font-size: 25rpx;
}

.subject-filter-arrow {
  color: #2563EB;
  margin-left: 4rpx;
}

button.notebook-retry {
  margin: 12rpx 0 0;
  background: #FEF2F2;
  color: #B91C1C;
}

.mastery-seg {
  display: flex;
  background: rgba(226, 232, 240, 0.58);
  padding: 6rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.65);
}

.m-seg-item {
  padding: 10rpx 18rpx;
  border-radius: 16rpx;
  font-size: 25rpx;
  font-weight: 600;
  color: #475569;
  transition: all 200ms cubic-bezier(0.22, 1, 0.36, 1);
}

.m-seg-active {
  background: rgba(255, 255, 255, 0.94);
  color: #0F172A;
  font-weight: 700;
  box-shadow: 0 4rpx 12rpx -2rpx rgba(15, 23, 42, 0.08);
}

/* 空状态 */
.empty-state-card {
  padding: 72rpx 32rpx;
  text-align: center;
}

.empty-illust {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.empty-title {
  font-size: 33rpx;
  font-weight: 700;
  color: #0F172A;
}

.empty-sub {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #64748B;
}

.error-msg {
  font-size: 28rpx;
  color: #DC2626;
}

/* 错题卡片流 */
.mistake-feed {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.feed-card {
  background: #FFFFFF;
  border-radius: 26rpx;
  padding: 26rpx 28rpx;
  border: 1rpx solid rgba(226, 232, 240, 0.9);
  box-shadow: 0 6rpx 22rpx -4rpx rgba(15, 23, 42, 0.04);
}

.border-todo {
  border-left: 8rpx solid #F59E0B;
}

.border-mastered {
  border-left: 8rpx solid #10B981;
}

.feed-card-top {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 14rpx;
}

.feed-subject {
  padding: 4rpx 14rpx;
  border-radius: 10rpx;
  background: #EFF6FF;
  color: #2563EB;
  font-size: 24rpx;
  font-weight: 700;
}

.feed-ai-tag {
  padding: 5rpx 15rpx;
  border-radius: 9rpx;
  line-height: 1.25;
  display: inline-flex;
  align-items: center;
  font-size: 25rpx;
  font-weight: 600;
}

.tag-analyzed {
  background: #e3f5ea;
  color: #196745;
}

.tag-pending {
  background: #eef2f7;
  color: #495b73;
}

.feed-img-tag {
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
  background: #F8FAFC;
  color: #475569;
  font-size: 22rpx;
}

.feed-status {
  margin-left: auto;
  padding: 4rpx 14rpx;
  border-radius: 9rpx;
  line-height: 1.25;
  display: inline-flex;
  align-items: center;
  font-size: 23rpx;
  font-weight: 700;
}

.st-todo {
  background: #FEF3C7;
  color: #D97706;
}

.st-mastered {
  background: #ECFDF5;
  color: #059669;
}

.feed-question {
  font-size: 31rpx;
  color: #0F172A;
  line-height: 1.6;
  margin-bottom: 18rpx;
}

.feed-card-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 14rpx;
  border-top: 1rpx solid #F1F5F9;
}

.feed-date {
  font-size: 24rpx;
  color: #94A3B8;
}

.feed-enter {
  font-size: 25rpx;
  color: #2563EB;
  font-weight: 600;
}

.load-more-box {
  padding: 32rpx 0;
  text-align: center;
}

.load-more-error {
  display: block;
  margin-bottom: 12rpx;
  color: #B91C1C;
  font-size: 26rpx;
}

button.load-more-button {
  color: #1D4ED8;
}

.load-more-end {
  font-size: 25rpx;
  color: #94A3B8;
}

button.dock-btn {
  width: 100%;
  height: 86rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 16rpx;
  border-radius: 20rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.dock-primary {
  background: linear-gradient(135deg, #2563EB 0%, #4F46E5 100%);
  color: #FFFFFF;
  box-shadow: 0 8rpx 20rpx -4rpx rgba(37, 99, 235, 0.35);
}
