.confirm-shell {
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

/* 顶部步骤条（Layer 3 毛玻璃吸顶胶囊） */
.stepper-bar {
  position: sticky;
  top: 12rpx;
  z-index: 40;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(255, 255, 255, 0.78);
  backdrop-filter: blur(20px) saturate(170%);
  -webkit-backdrop-filter: blur(20px) saturate(170%);
  padding: 20rpx 28rpx;
  border-radius: 24rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  box-shadow: 0 8rpx 22rpx -6rpx rgba(15, 23, 42, 0.08);
}

.st-item {
  font-size: 25rpx;
  color: #94A3B8;
  font-weight: 600;
}

.st-done {
  color: #10B981;
}

.st-current {
  color: #2563EB;
  font-weight: 800;
}

.st-line {
  flex: 1;
  height: 4rpx;
  background: #E2E8F0;
  margin: 0 16rpx;
  border-radius: 999rpx;
}

.st-line-done {
  background: #10B981;
}

.state-card {
  padding: 60rpx 32rpx;
  text-align: center;
}

.original-question {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.original-question-image {
  display: block;
  width: 100%;
  background: #FFFFFF;
  border: 1rpx solid #E2E8F0;
  border-radius: 12rpx;
}

button.original-question-zoom {
  margin: 0;
  background: #EFF6FF;
  color: #1D4ED8;
}

/* 表单字段 */
.label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.field-label {
  font-size: 29rpx;
  font-weight: 700;
  color: #0F172A;
}

.field-hint {
  font-size: 24rpx;
  color: #64748B;
}

.add-subject-pill {
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: #EFF6FF;
  color: #2563EB;
  font-size: 24rpx;
  font-weight: 700;
}

.subject-picker-box {
  height: 84rpx;
  padding: 0 24rpx;
  border-radius: 18rpx;
  background: #F8FAFC;
  border: 2rpx solid #E2E8F0;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.picker-selected {
  font-size: 31rpx;
  font-weight: 700;
  color: #0F172A;
}

.picker-placeholder {
  font-size: 29rpx;
  color: #94A3B8;
}

.picker-chevron {
  font-size: 26rpx;
  color: #2563EB;
  font-weight: 600;
}

.question-editor {
  width: 100%;
  min-height: 180rpx;
  padding: 22rpx 24rpx;
  border-radius: 20rpx;
  background: #F8FAFC;
  border: 2rpx solid #E2E8F0;
  font-size: 31rpx;
  line-height: 1.65;
  color: #0F172A;
}

.wrong-input {
  width: 100%;
  height: 82rpx;
  padding: 16rpx 24rpx;
  border-radius: 18rpx;
  background: #FFFBEB;
  border: 2rpx solid #FDE68A;
  font-size: 28rpx;
  color: #92400E;
}

.tag-list {
  margin-top: 12rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.kp-tag {
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: #EEF2FF;
  color: #4F46E5;
  font-size: 25rpx;
  font-weight: 600;
}

/* 未分析时的 AI 召唤卡片 */
.ai-invite-card {
  background: linear-gradient(145deg, #EFF6FF 0%, #EEF2FF 100%);
  border: 2rpx solid #BFDBFE;
}

.ai-invite-top {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.ai-invite-title {
  font-size: 33rpx;
  font-weight: 800;
  color: #1E3A8A;
}

.ai-invite-quota {
  font-size: 24rpx;
  color: #2563EB;
  font-weight: 600;
}

.ai-invite-desc {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #475569;
  line-height: 1.55;
}

button.ai-trigger-btn {
  width: 100%;
  min-width: 0;
  margin-top: 24rpx;
  background: #FFFFFF;
  color: #2563EB;
  border: 2rpx solid #93C5FD;
  font-size: 29rpx;
  font-weight: 700;
  height: 82rpx;
  line-height: 82rpx;
  border-radius: 18rpx;
}

/* 已分析结果卡片 */
.ai-result-card {
  border: 2rpx solid #C7D2FE;
}

.ai-result-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

button.details-toggle {
  margin: 0;
  padding: 6rpx 18rpx;
  border-radius: 16rpx;
  background: #EEF2FF;
  color: #4F46E5;
  font-size: 28rpx;
  font-weight: 700;
}

.reanalyze-pill {
  font-size: 26rpx;
  color: #2563EB;
  font-weight: 600;
}

.diagnostic-callout {
  padding: 22rpx 24rpx;
  border-radius: 20rpx;
  background: #FFFBEB;
  border-left: 8rpx solid #F59E0B;
}

.diag-title {
  font-size: 27rpx;
  font-weight: 700;
  color: #B45309;
  margin-bottom: 6rpx;
}

.diag-body {
  font-size: 28rpx;
  color: #78350F;
  line-height: 1.6;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}

.answer-editor {
  width: 100%;
  min-height: 100rpx;
  padding: 20rpx 24rpx;
  border-radius: 18rpx;
  background: #ECFDF5;
  border: 2rpx solid #A7F3D0;
  font-size: 30rpx;
  color: #065F46;
  font-weight: 600;
  margin-top: 10rpx;
}

.analysis-editor {
  width: 100%;
  min-height: 220rpx;
  padding: 22rpx 24rpx;
  border-radius: 18rpx;
  background: #F8FAFC;
  border: 2rpx solid #E2E8F0;
  font-size: 29rpx;
  line-height: 1.65;
  color: #1E293B;
  margin-top: 10rpx;
}

.error-banner {
  padding: 18rpx 24rpx;
  border-radius: 18rpx;
  background: #FEF2F2;
  border: 1rpx solid #FECACA;
  margin-bottom: 20rpx;
}

.error-banner-text {
  font-size: 26rpx;
  color: #DC2626;
}
