.detail-shell {
  padding-bottom: calc(170rpx + env(safe-area-inset-bottom));
}

.state-box {
  padding: 64rpx 32rpx;
  text-align: center;
}

.error-text {
  color: #DC2626;
  font-size: 28rpx;
}

/* 方案 A：闪卡正反面切换器（Layer 3 毛玻璃分段胶囊） */
.flashcard-tabs {
  position: sticky;
  top: 12rpx;
  z-index: 40;
  display: flex;
  background: rgba(226, 232, 240, 0.56);
  backdrop-filter: blur(20px) saturate(170%);
  -webkit-backdrop-filter: blur(20px) saturate(170%);
  border: 1rpx solid rgba(255, 255, 255, 0.78);
  box-shadow: 0 8rpx 22rpx -6rpx rgba(15, 23, 42, 0.08);
  padding: 8rpx;
  border-radius: 24rpx;
  margin-bottom: 24rpx;
}

.fc-tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 12rpx;
  border-radius: 18rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #475569;
  transition: all 220ms cubic-bezier(0.22, 1, 0.36, 1);
}

.fc-tab-active {
  background: rgba(255, 255, 255, 0.94);
  color: #0F172A;
  font-weight: 800;
  box-shadow: 0 4rpx 14rpx -2rpx rgba(15, 23, 42, 0.1);
}

.fc-tab-ai {
  color: #2563EB;
}

/* 试卷原题卡 */
.exam-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.exam-badges {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.exam-subject {
  padding: 6rpx 18rpx;
  border-radius: 12rpx;
  background: #EFF6FF;
  color: #2563EB;
  font-size: 26rpx;
  font-weight: 800;
}

.exam-ai-pill {
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.ai-ready {
  background: #EEF2FF;
  color: #4F46E5;
}

.ai-none {
  background: #F1F5F9;
  color: #64748B;
}

.exam-mastery {
  padding: 6rpx 18rpx;
  border-radius: 9rpx;
  font-size: 24rpx;
  font-weight: 700;
}

.mastery-yes {
  background: #ECFDF5;
  color: #059669;
}

.mastery-no {
  background: #FEF3C7;
  color: #D97706;
}

.exam-question-body {
  font-size: 34rpx;
  color: #0F172A;
  line-height: 1.72;
  white-space: pre-wrap;
  padding: 8rpx 0;
}

.exam-image-box {
  margin-top: 20rpx;
  border-radius: 20rpx;
  overflow: hidden;
  border: 2rpx solid #E2E8F0;
  background: #F8FAFC;
}

.exam-image {
  width: 100%;
  display: block;
}

.exam-image-caption {
  padding: 12rpx;
  text-align: center;
  font-size: 24rpx;
  color: #64748B;
  background: #F1F5F9;
}

.exam-tags {
  margin-top: 20rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.exam-tag {
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: #F8FAFC;
  border: 1rpx solid #E2E8F0;
  color: #475569;
  font-size: 24rpx;
  font-weight: 600;
}

/* 闪卡正面：折叠防干扰错解框 */
.wrong-collapse-box {
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  border-radius: 18rpx;
  background: #F8FAFC;
  border: 2rpx dashed #CBD5E1;
}

.wrong-collapse-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.wrong-collapse-title {
  font-size: 25rpx;
  color: #64748B;
  font-weight: 600;
}

.wrong-collapse-toggle {
  font-size: 25rpx;
  color: #2563EB;
  font-weight: 700;
  white-space: nowrap;
}

.wrong-collapse-body {
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #E2E8F0;
  font-size: 28rpx;
  color: #92400E;
  line-height: 1.55;
}

.flip-cta-btn {
  margin-top: 28rpx;
  padding: 24rpx 28rpx;
  border-radius: 20rpx;
  background: #EFF6FF;
  border: 2rpx solid #BFDBFE;
  color: #1D4ED8;
  text-align: center;
  font-size: 29rpx;
  font-weight: 800;
}

.wrong-sticky-note {
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  border-radius: 18rpx;
  background: #FFFBEB;
  border-left: 8rpx solid #F59E0B;
}

.wrong-sticky-title {
  font-size: 25rpx;
  font-weight: 700;
  color: #B45309;
  margin-bottom: 6rpx;
}

.wrong-sticky-text {
  font-size: 28rpx;
  color: #78350F;
  line-height: 1.55;
}

/* 闪卡背面 */
.flashcard-back-card {
  border: 2rpx solid #C7D2FE;
}

.back-top-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.back-front-link {
  font-size: 26rpx;
  color: #475569;
  font-weight: 600;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #F1F5F9;
}

.back-reanalyze-link {
  font-size: 26rpx;
  color: #2563EB;
  font-weight: 700;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #EFF6FF;
}

.revealed-box {
  padding: 24rpx;
  border-radius: 20rpx;
  margin-top: 18rpx;
}

.box-hint {
  background: #FFFBEB;
  border-left: 8rpx solid #F59E0B;
}

.box-answer {
  background: #ECFDF5;
  border-left: 8rpx solid #10B981;
  margin-top: 0;
}

.box-analysis {
  background: #F8FAFC;
  border: 1rpx solid #E2E8F0;
}

.rev-header {
  font-size: 26rpx;
  font-weight: 800;
  color: #475569;
  margin-bottom: 10rpx;
}

.box-hint .rev-header {
  color: #B45309;
}

.box-answer .rev-header {
  color: #047857;
}

.wrong-compare-line {
  font-size: 26rpx;
  color: #9A3412;
  background: rgba(255, 255, 255, 0.7);
  padding: 10rpx 14rpx;
  border-radius: 12rpx;
  margin-bottom: 10rpx;
}

.rev-content {
  font-size: 30rpx;
  color: #0F172A;
  line-height: 1.72;
  white-space: pre-wrap;
}

.answer-bold {
  font-weight: 800;
  color: #065F46;
}

.rev-disclaimer {
  margin-top: 16rpx;
  padding-top: 12rpx;
  border-top: 1rpx dashed #CBD5E1;
  font-size: 23rpx;
  color: #94A3B8;
}

/* 召唤 AI 诊断卡 */
.summon-ai-card {
  background: linear-gradient(145deg, #EFF6FF 0%, #EEF2FF 100%);
  border: 2rpx solid #93C5FD;
}

.summon-badge-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.summon-badge {
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: #2563EB;
  color: #FFFFFF;
  font-size: 23rpx;
  font-weight: 700;
}

.summon-quota {
  font-size: 24rpx;
  color: #1D4ED8;
  font-weight: 600;
}

.summon-title {
  font-size: 35rpx;
  font-weight: 800;
  color: #0F172A;
}

.summon-desc {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #475569;
  line-height: 1.5;
}

.summon-perks {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 20rpx 0 28rpx;
}

.s-perk {
  padding: 8rpx 18rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.85);
  color: #1E3A8A;
  font-size: 24rpx;
  font-weight: 600;
}

/* 个人笔记卡 */
.notes-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.notes-save-pill {
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  background: #EFF6FF;
  color: #2563EB;
  font-size: 25rpx;
  font-weight: 700;
}

.notes-editor {
  width: 100%;
  min-height: 150rpx;
  padding: 22rpx;
  border-radius: 18rpx;
  background: #F8FAFC;
  border: 2rpx solid #E2E8F0;
  font-size: 29rpx;
  line-height: 1.6;
  color: #0F172A;
}

/* 底部复习操作坞 */
.review-dock {
  display: flex;
  gap: 18rpx;
}

button.mastery-main-btn {
  width: auto;
  min-width: 0;
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 18rpx;
  border-radius: 20rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.btn-master {
  background: linear-gradient(135deg, #10B981 0%, #059669 100%);
  color: #FFFFFF;
  box-shadow: 0 8rpx 22rpx -4rpx rgba(16, 185, 129, 0.38);
}

.btn-unmaster {
  background: #FEF3C7;
  color: #B45309;
  border: 2rpx solid #FCD34D;
}

button.more-side-btn {
  width: 160rpx;
  min-width: 0;
  flex-shrink: 0;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  border-radius: 20rpx;
  background: #F8FAFC;
  border: 2rpx solid #E2E8F0;
  color: #475569;
  font-size: 28rpx;
  font-weight: 600;
}

.review-action {
  margin: 18rpx 0;
  color: var(--primary, #355dc9);
  background: #eef2ff;
  font-size: 30rpx;
}

.review-paragraph + .review-paragraph {
  margin-top: 18rpx;
}

.practice-entry .primary-button {
  margin-top: 24rpx;
}

.practice-cost {
  margin-top: 8rpx;
  color: #52647e;
  font-size: 26rpx;
}

.analysis-status {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 16rpx;
  border-radius: 9rpx;
  font-size: 25rpx;
  font-weight: 600;
}

.analysis-status-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: currentColor;
}

.is-parsed {
  color: #196745;
  background: #e3f5ea;
}

.is-unparsed {
  color: #495b73;
  background: #eef2f7;
}

.figure-button {
  margin: 16rpx 0 0;
  color: #254baf;
  background: #edf2ff;
}

.practice-levels {
  display: flex;
  gap: 12rpx;
}

.practice-level {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 20rpx 8rpx;
  border-radius: 20rpx;
  font-size: 29rpx;
  font-weight: 700;
}

.level-number {
  font-size: 35rpx;
  font-weight: 800;
}

.level-similar { background: #e8efff; color: #2349a4; }
.level-advanced { background: #f0e9ff; color: #624095; }
.level-challenge { background: #fff0df; color: #854513; }

.practice-cost {
  text-align: center;
}
