.pet-page {
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
}

/* 三段胶囊导航（Layer 3 吸顶流体毛玻璃胶囊） */
.pet-tabs {
  position: sticky;
  top: 12rpx;
  z-index: 40;
  display: flex;
  background: rgba(226, 232, 240, 0.56);
  backdrop-filter: blur(20px) saturate(170%);
  -webkit-backdrop-filter: blur(20px) saturate(170%);
  border: 1rpx solid rgba(255, 255, 255, 0.78);
  box-shadow: 0 8rpx 22rpx -6rpx rgba(15, 23, 42, 0.08);
  padding: 8rpx;
  border-radius: 24rpx;
  margin-bottom: 22rpx;
  gap: 8rpx;
}

.pet-tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 16rpx 10rpx;
  font-size: 27rpx;
  font-weight: 700;
  color: #475569;
  border-radius: 18rpx;
  transition: all 220ms cubic-bezier(0.22, 1, 0.36, 1);
}

.pet-tab-active {
  background: rgba(255, 255, 255, 0.94);
  color: #0F172A;
  box-shadow: 0 4rpx 14rpx -2rpx rgba(15, 23, 42, 0.08);
}

.tab-badge {
  background: #EA580C;
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: 800;
  padding: 2rpx 10rpx;
  border-radius: 999rpx;
  line-height: 1.3;
}

.tab-badge-amber {
  background: #2563EB;
}

/* 暖杏主陪伴舞台 */
.stage-card {
  border-radius: 30rpx;
  border: 2rpx solid #FED7AA;
  padding: 26rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 10rpx 30rpx -8rpx rgba(234, 88, 12, 0.12);
}

.stage-top-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.level-badge {
  background: rgba(255, 255, 255, 0.92);
  font-size: 24rpx;
  font-weight: 800;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
}

.stage-actions {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.switch-pet-btn {
  background: rgba(255, 255, 255, 0.92);
  color: #0F172A;
  font-size: 24rpx;
  font-weight: 700;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(15, 23, 42, 0.08);
}

.more-pet-btn {
  width: 52rpx;
  height: 52rpx;
  line-height: 50rpx;
  text-align: center;
  background: rgba(255, 255, 255, 0.85);
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #475569;
}

.stage-hero-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.avatar-wrap {
  position: relative;
  width: 196rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.pet-avatar {
  width: 184rpx;
  height: 184rpx;
  border-radius: 36rpx;
  border: 4rpx solid #FFFFFF;
  box-shadow: 0 12rpx 26rpx rgba(15, 23, 42, 0.12);
  background: #FFF9F2;
  transition: transform 0.18s ease;
}

@keyframes floatAnim {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-6rpx); }
}

.pet-float {
  animation: floatAnim 2.8s ease-in-out infinite;
}

.pet-bounce {
  transform: scale(1.08) translateY(-10rpx);
}

.grad-cap-badge {
  position: absolute;
  top: -10rpx;
  right: 2rpx;
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  font-size: 30rpx;
  background: #2563EB;
  border-radius: 999rpx;
  border: 3rpx solid #FFFFFF;
  box-shadow: 0 4rpx 10rpx rgba(37, 99, 235, 0.3);
}

.pet-name-tag {
  margin-top: -16rpx;
  z-index: 2;
  background: #0F172A;
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 700;
  padding: 4rpx 18rpx;
  border-radius: 999rpx;
  border: 2rpx solid #FFFFFF;
}

.hero-right {
  flex: 1;
  min-width: 0;
}

.speech-bubble {
  background: rgba(255, 255, 255, 0.78);
  backdrop-filter: blur(16px) saturate(160%);
  -webkit-backdrop-filter: blur(16px) saturate(160%);
  border: 1rpx solid rgba(255, 255, 255, 0.92);
  border-radius: 22rpx;
  padding: 16rpx 18rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 8rpx 20rpx -6rpx rgba(15, 23, 42, 0.08),
              inset 0 1rpx 0 rgba(255, 255, 255, 0.95);
}

.bubble-text {
  font-size: 25rpx;
  color: #334155;
  line-height: 1.5;
  font-weight: 500;
}

.exp-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.exp-label {
  font-size: 23rpx;
  color: #475569;
  font-weight: 600;
}

.exp-num {
  font-size: 24rpx;
  font-weight: 800;
}

.exp-track {
  height: 16rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 999rpx;
  overflow: hidden;
  padding: 2rpx;
}

.exp-fill {
  height: 100%;
  border-radius: 999rpx;
  transition: width 0.25s ease;
}

.trait-banner {
  margin-top: 20rpx;
  background: rgba(255, 255, 255, 0.88);
  border-radius: 18rpx;
  padding: 14rpx 18rpx;
  font-size: 25rpx;
  line-height: 1.45;
  color: #334155;
}

.trait-title {
  font-weight: 800;
}

.metrics-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 16rpx;
}

.metric-cell {
  background: rgba(255, 255, 255, 0.85);
  border-radius: 18rpx;
  padding: 14rpx 8rpx;
  text-align: center;
}

.metric-val {
  font-size: 30rpx;
  font-weight: 800;
  color: #0F172A;
}

.metric-key {
  font-size: 22rpx;
  color: #64748B;
  margin-top: 2rpx;
}

/* 投喂区 */
.section-heading-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin: 8rpx 4rpx 14rpx;
}

.section-heading {
  font-size: 30rpx;
  font-weight: 800;
  color: #0F172A;
}

.section-sub {
  font-size: 24rpx;
  color: #64748B;
}

.snack-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.snack-card {
  width: 100%;
  min-width: 0;
  margin-bottom: 0;
  padding: 22rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: 16rpx;
  overflow: hidden;
}

.snack-top {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.snack-icon-box {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 39rpx;
  flex-shrink: 0;
}

.fish-box {
  background: #EFF6FF;
}

.fruit-box {
  background: #FFFBEB;
}

.snack-name {
  font-size: 27rpx;
  font-weight: 700;
  color: #0F172A;
}

.snack-stock {
  font-size: 23rpx;
  color: #64748B;
  margin-top: 2rpx;
}

button.snack-btn {
  width: 100%;
  min-width: 0;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 12rpx;
  font-size: 26rpx;
  font-weight: 700;
  border-radius: 16rpx;
  white-space: nowrap;
}

.fish-btn {
  background: #EFF6FF;
  color: #1D4ED8;
}

.fruit-btn {
  background: linear-gradient(135deg, #F59E0B 0%, #EA580C 100%);
  color: #FFFFFF;
}

.guide-card {
  border-style: dashed;
  background: #FFFFFF;
}

.guide-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #0F172A;
  margin-bottom: 10rpx;
}

.guide-line {
  font-size: 25rpx;
  color: #475569;
  line-height: 1.65;
}

/* 转盘区 */
.wheel-header-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
}

.wheel-header-left {
  flex: 1;
}

.wheel-title {
  font-size: 33rpx;
  font-weight: 800;
  color: #0F172A;
}

.wheel-sub {
  font-size: 24rpx;
  color: #64748B;
  margin-top: 4rpx;
}

.ticket-pill {
  flex-shrink: 0;
  background: #FEF3C7;
  color: #B45309;
  font-size: 28rpx;
  font-weight: 800;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
}

.wheel-board-card {
  padding: 24rpx;
  background: #fff8e9;
  border: 2rpx solid #f6dfb4;
}

.wheel-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  grid-template-areas: "one two three" "eight draw four" "seven six five";
  gap: 14rpx;
}

.wheel-position-0 { grid-area: one; }
.wheel-position-1 { grid-area: two; }
.wheel-position-2 { grid-area: three; }
.wheel-position-3 { grid-area: four; }
.wheel-position-4 { grid-area: five; }
.wheel-position-5 { grid-area: six; }
.wheel-position-6 { grid-area: seven; }
.wheel-position-7 { grid-area: eight; }

.wheel-cell,
.wheel-draw {
  box-sizing: border-box;
  min-width: 0;
  min-height: 150rpx;
  border-radius: 24rpx;
  padding: 12rpx 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.wheel-cell {
  border: 3rpx solid rgba(128, 93, 49, 0.15);
  transition: transform 0.1s ease, border-color 0.1s ease;
}

.wheel-cell-active {
  border-color: #b84613;
  transform: scale(1.04);
  box-shadow: 0 0 0 4rpx #ffd38a, 0 8rpx 18rpx rgba(131, 48, 9, 0.2);
}

.wheel-cell-icon {
  font-size: 47rpx;
  line-height: 1.1;
}

.wheel-cell-name {
  font-size: 24rpx;
  font-weight: 700;
  color: #334155;
  margin-top: 8rpx;
  overflow-wrap: anywhere;
}

.wheel-grid .wheel-draw {
  grid-area: draw;
  width: 100%;
  margin: 0;
  background: linear-gradient(150deg, #fff0b7, #ffc66e);
  color: #662a08;
  border: 2rpx solid #eab15b;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.25;
}

.wheel-draw::after { border: 0; }
.wheel-draw-icon { font-size: 29rpx; margin-bottom: 5rpx; }
.wheel-draw-cost { font-size: 21rpx; font-weight: 500; margin-top: 6rpx; }
.wheel-grid .wheel-draw[disabled] { background: #f7e7c9; color: #765839; }

.prize-detail-card {
  background: #FFFFFF;
}

.prize-detail-top {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.prize-detail-icon {
  font-size: 39rpx;
}

.prize-detail-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #0F172A;
}

.prize-detail-desc {
  font-size: 26rpx;
  color: #334155;
  line-height: 1.55;
}

.prize-detail-rule {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #64748B;
}

/* 心愿卡包 */
.bag-filter-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.bag-filter-chip {
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  border: 1rpx solid #E2E8F0;
  font-size: 25rpx;
  font-weight: 600;
  color: #475569;
}

.bag-filter-active {
  background: #0F172A;
  color: #FFFFFF;
  border-color: #0F172A;
}

.empty-bag-card {
  text-align: center;
  padding: 56rpx 32rpx;
}

.empty-bag-icon {
  font-size: 64rpx;
  margin-bottom: 14rpx;
}

.empty-bag-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #0F172A;
}

.empty-bag-desc {
  font-size: 25rpx;
  color: #64748B;
  margin-top: 8rpx;
  line-height: 1.5;
}

.empty-bag-btn {
  margin-top: 24rpx;
}

.wish-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx;
}

.wish-redeemed {
  opacity: 0.7;
}

.wish-left {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.wish-icon-box {
  width: 84rpx;
  height: 84rpx;
  border-radius: 22rpx;
  background: #FFF7ED;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 45rpx;
  flex-shrink: 0;
}

.wish-meta {
  flex: 1;
  min-width: 0;
}

.wish-name {
  font-size: 29rpx;
  font-weight: 700;
  color: #0F172A;
}

.wish-benefit {
  font-size: 24rpx;
  color: #475569;
  margin-top: 4rpx;
  line-height: 1.4;
}

.wish-time {
  font-size: 22rpx;
  color: #94A3B8;
  margin-top: 6rpx;
}

button.redeem-action-btn {
  width: auto;
  min-width: 0;
  flex-shrink: 0;
  height: 64rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0 22rpx;
  background: #EA580C;
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 700;
  border-radius: 16rpx;
}

.redeem-done-btn {
  background: #ECFDF5;
  color: #047857;
}

/* 5选1 宠物精灵抽屉弹窗（Layer 3 流体毛玻璃底栏弹窗） */
.picker-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 120;
  background: rgba(15, 23, 42, 0.42);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  display: flex;
  align-items: flex-end;
}

.picker-sheet {
  width: 100%;
  max-height: 88vh;
  overflow-y: auto;
  background: rgba(255, 255, 255, 0.88);
  backdrop-filter: blur(28px) saturate(180%);
  -webkit-backdrop-filter: blur(28px) saturate(180%);
  border-top: 1rpx solid rgba(255, 255, 255, 0.92);
  box-shadow: 0 -16rpx 44rpx -8rpx rgba(15, 23, 42, 0.18),
              inset 0 1rpx 0 rgba(255, 255, 255, 0.95);
  border-radius: 40rpx 40rpx 0 0;
  padding: 16rpx 28rpx calc(36rpx + env(safe-area-inset-bottom));
}

.sheet-grabber {
  width: 72rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: rgba(148, 163, 184, 0.48);
  margin: 0 auto 20rpx;
}

.picker-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 22rpx;
}

.picker-title {
  font-size: 33rpx;
  font-weight: 800;
  color: #0F172A;
}

.picker-sub {
  font-size: 24rpx;
  color: #64748B;
  margin-top: 4rpx;
}

.picker-close {
  width: 52rpx;
  height: 52rpx;
  line-height: 52rpx;
  text-align: center;
  border-radius: 999rpx;
  background: #F1F5F9;
  color: #475569;
  font-size: 28rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.species-grid {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 10rpx;
  margin-bottom: 22rpx;
}

.species-item {
  border-radius: 20rpx;
  border: 2rpx solid #E2E8F0;
  background: #F8FAFC;
  padding: 12rpx 6rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.species-item-active {
  border-width: 3rpx;
  box-shadow: 0 6rpx 16rpx rgba(15, 23, 42, 0.08);
}

.species-thumb {
  width: 84rpx;
  height: 84rpx;
  border-radius: 20rpx;
  background: #FFF9F2;
}

.species-name {
  font-size: 24rpx;
  font-weight: 800;
  color: #0F172A;
  margin-top: 8rpx;
}

.species-tag {
  font-size: 20rpx;
  color: #64748B;
  margin-top: 2rpx;
  white-space: nowrap;
}

.species-profile-card {
  border-radius: 24rpx;
  border: 2rpx solid #E2E8F0;
  padding: 22rpx;
  margin-bottom: 20rpx;
}

.profile-head {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-bottom: 14rpx;
}

.profile-avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 24rpx;
  border: 3rpx solid #FFFFFF;
  flex-shrink: 0;
  background: #FFF9F2;
}

.profile-head-info {
  flex: 1;
  min-width: 0;
}

.profile-name-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.profile-name {
  font-size: 33rpx;
  font-weight: 800;
  color: #0F172A;
}

.profile-pill {
  background: rgba(255, 255, 255, 0.9);
  font-size: 22rpx;
  font-weight: 700;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
}

.profile-trait {
  font-size: 24rpx;
  font-weight: 700;
  margin-top: 6rpx;
  line-height: 1.4;
}

.profile-detail-line {
  font-size: 25rpx;
  color: #334155;
  line-height: 1.5;
  margin-top: 8rpx;
}

.detail-label {
  font-weight: 700;
  color: #0F172A;
}

.nickname-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 22rpx;
}

.nickname-label {
  font-size: 26rpx;
  font-weight: 700;
  color: #334155;
  flex-shrink: 0;
}

.nickname-input {
  flex: 1;
  height: 78rpx;
  background: #F8FAFC;
  border: 2rpx solid #E2E8F0;
  border-radius: 16rpx;
  padding: 0 20rpx;
  font-size: 27rpx;
}

/* 底部暖色主按钮 */
button.primary-button.dock-warm-btn,
.dock-warm-btn {
  background: linear-gradient(135deg, #F59E0B 0%, #EA580C 100%);
  box-shadow: 0 10rpx 24rpx -6rpx rgba(234, 88, 12, 0.38);
}
