.onboard-shell {
  min-height: 100vh;
  background: #F7F8FB;
  padding-top: 48rpx;
}

.onboard-step {
  display: inline-block;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: #EAF1FC;
  color: #184687;
  font-size: 24rpx;
  font-weight: 700;
}

.onboard-title {
  margin-top: 22rpx;
  font-size: 46rpx;
  font-weight: 800;
  color: #17243A;
  line-height: 1.25;
}

.onboard-sub {
  margin-top: 14rpx;
  font-size: 28rpx;
  color: #4E5D72;
  line-height: 1.5;
}

.onboard-card {
  margin-top: 40rpx;
  padding: 30rpx;
}

.onboard-input {
  height: 92rpx;
  padding: 0 24rpx;
  border: 2rpx solid #DBE3EF;
  border-radius: 18rpx;
  background: #F8FAFC;
  font-size: 34rpx;
  color: #0F172A;
}

.onboard-preview {
  margin-top: 20rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #184687;
}

.onboard-error {
  margin-top: 16rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #B91C1C;
}

button.onboard-primary {
  margin: 40rpx 0 0;
  border-radius: 20rpx;
  background: #184687;
  color: #FFFFFF;
  font-size: 33rpx;
  font-weight: 700;
  line-height: 88rpx;
}
