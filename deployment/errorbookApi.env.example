# 请在微信云开发控制台（环境：vision-prod-d6gm5kqaz79d6a35f → 云函数 → errorbookApi → 函数配置 → 环境变量）中配置
# 禁止将真实密钥提交到代码仓库或放进 miniprogram 前端包。
# 上体验版前，在隔离的云环境验证跨 AppID 的文本和图片审核，以及事务读写。
# eb_analysis_requests 保存分析与宠物操作的幂等回执；expiresAt 是写入后 7 天的 BSON Date。
# 清理策略：在 CloudBase 设置 expiresAt TTL 到期即删除，只作用于这个回执集合。
# 启用前核对数据与保留窗口，TTL 开启后也会清理已过期历史回执。不要对错题或用户集合配置 TTL。
# 错题索引：eb_user_created (userId↑, createdAt↓, _id↓)；
# eb_user_subject_created (userId↑, subjectId↑, createdAt↓, _id↓)；
# eb_user_mastery (userId↑, masteryLevel↑)。回执集合索引：eb_receipt_user (userId↑)。
# 新环境按上列字段建立索引。宠物动作版本需与支持 POST /api/pet/action 的小程序构建配套。

# 云函数超时预算：cloudfunctions/errorbookApi/config.json 中 timeout=60（单位：秒，平台默认 3 秒）。
# AI_TIMEOUT_MS 必须小于云函数超时，并为内容安全校验与数据库读写预留时间；不配置时回退为 50 秒。
# 修改 config.json 后必须重新部署云函数，并在控制台核对实际生效的超时值。
AI_TIMEOUT_MS=45000

# 可选：/api/health 真实模型探测（live=1）及无微信身份上下文调用时的保护令牌。
# 小程序已登录用户的普通只读自检（无 live=1）直接校验微信身份，无需传令牌；
# 发起真实 AI 推理（live=1）时必须配置该值，并在请求体 data.token 中传入（禁止放在 URL 查询参数中）。
# 建议上线前配置；诊断接口只返回布尔状态与错误码，不返回密钥、openid 原文或模型配置值。
# HEALTH_TOKEN=

# 选择默认平台协议：openai（含阿里云百炼 / DeepSeek / 火山方舟 / 智谱等 OpenAI 兼容多模态接口）或 gemini
AI_PROVIDER=openai
# 可选：单独指定 OCR / 解题协议（默认跟随 AI_PROVIDER）
# AI_OCR_PROVIDER=
# AI_SOLVE_PROVIDER=

# 腾讯云高精度 OCR 独立于解题模型。启用前确认文字识别服务已开通并关闭后付费。
# AI_OCR_PROVIDER=tencent
# TENCENT_OCR_SECRET_ID=
# TENCENT_OCR_SECRET_KEY=

# OpenAI 兼容多模态协议配置（默认同时用于解题与未单独指定时的 OCR；需选用支持图片理解的模型）
# 示例 1（阿里云百炼）：OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1 ，OPENAI_MODEL=qwen3-vl-plus，OPENAI_OCR_MODEL=qwen3-vl-flash
# 示例 2（DeepSeek 多模态）：OPENAI_BASE_URL=https://api.deepseek.com/v1 ，OPENAI_MODEL=deepseek-flash
OPENAI_API_KEY=
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_MODEL=qwen3-vl-plus

# 可选：OpenAI 兼容接口的 OCR 与解题模型分离（未设置时均回退上方 OPENAI_* 配置）
# OPENAI_OCR_MODEL=qwen3-vl-flash
# OPENAI_OCR_BASE_URL=
# OPENAI_OCR_API_KEY=
# 若解题较慢，可单独为解题指定更快模型（例如 qwen3-vl-flash）
# OPENAI_SOLVE_MODEL=
# OPENAI_SOLVE_BASE_URL=

# 可选：思考模式与推理深度控制
# 注：已在已知支持思考控制的接口（百炼 DashScope、DeepSeek、火山方舟、智谱及 THINKING_CAPABLE_HOSTS）上默认对 OCR 关闭思考以加速；
# 若需全局/按任务覆盖可取消注释（true=关闭思考，false=开启思考），服务端返回 400 不识别思考字段时会自动降级重试
# 解题默认关闭思考以压低真机等待时间；如遇接口不识别该字段会自动降级重试。
OPENAI_SOLVE_DISABLE_THINKING=true
# OPENAI_DISABLE_THINKING=
# OPENAI_OCR_DISABLE_THINKING=true
# OPENAI_REASONING_EFFORT=
# THINKING_CAPABLE_HOSTS=

# 或 Google Gemini 官方接口配置
GOOGLE_API_KEY=
GEMINI_BASE_URL=
GEMINI_MODEL=gemini-2.5-flash
# GEMINI_OCR_MODEL=
# GEMINI_OCR_BASE_URL=
# GEMINI_OCR_API_KEY=
# GEMINI_SOLVE_MODEL=
# GEMINI_DISABLE_THINKING=
# GEMINI_OCR_DISABLE_THINKING=
# GEMINI_SOLVE_DISABLE_THINKING=
